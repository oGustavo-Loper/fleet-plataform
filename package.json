{
  "name": "fleet-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@nestjs/core",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fleet/web --filter @fleet/api dev",
    "docker:dev": "docker compose -f infra/docker/compose.yml up --build",
    "docker:dev:down": "docker compose -f infra/docker/compose.yml down",
    "build": "pnpm -r build",
    "test": "pnpm --filter @fleet/api test && pnpm --filter @fleet/web test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @fleet/api prisma:generate",
    "db:migrate": "pnpm --filter @fleet/api prisma:migrate"
  }
}
