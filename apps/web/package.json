{
  "name": "@fleet/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "find src \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print0 | xargs -0 env TS_NODE_TRANSPILE_ONLY=true node --loader ../../node_modules/.pnpm/node_modules/ts-node/esm.mjs --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@fleet/shared-types": "workspace:*",
    "@fleet/shared-validation": "workspace:*",
    "@fleet/ui": "workspace:*",
    "@tanstack/react-query": "^5.74.4",
    "dexie": "^4.0.11",
    "graphql": "^16.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.1",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}
