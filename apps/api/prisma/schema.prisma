generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  COMPANY
  INDIVIDUAL
}

enum PlanStatus {
  TRIAL
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  COMPANY
  DRIVER
  INDIVIDUAL
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SOLD
}

enum FuelType {
  GASOLINE
  ETHANOL
  DIESEL
  FLEX
  ELECTRIC
  HYBRID
}

enum AlertSeverity {
  info
  warning
  critical
}

enum SyncEventStatus {
  PENDING
  PROCESSING
  SYNCED
  CONFLICT
}

model Tenant {
  id             String        @id @default(uuid())
  name           String
  accountType    AccountType
  documentNumber String?       @db.VarChar(20)
  planCode       String        @default("ESSENTIAL_FREE")
  planStatus     PlanStatus    @default(TRIAL)
  vehicleLimit   Int?
  billingProvider String?
  billingCustomerId String?
  billingSubscriptionId String?
  billingActivatedAt DateTime?
  users          User[]
  drivers        Driver[]
  vehicles       Vehicle[]
  syncEvents     SyncEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, role])
}

model Driver {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName        String
  cpf             String              @db.VarChar(14)
  cnh             String              @db.VarChar(20)
  cnhCategory     String              @db.VarChar(4)
  cnhExpiresAt    DateTime
  assignments     VehicleAssignment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenantId, fullName])
}

model Vehicle {
  id                   String              @id @default(uuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plate                String
  model                String
  brand                String
  year                 Int
  fuelType             FuelType
  currentKm            Int
  ownerName            String
  companyName          String?
  status               VehicleStatus
  assignments          VehicleAssignment[]
  odometerLogs         OdometerLog[]
  fuelLogs             FuelLog[]
  maintenanceLogs      MaintenanceLog[]
  partReplacements     PartReplacement[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([tenantId, plate])
  @@index([tenantId, status])
}

model VehicleAssignment {
  id         String   @id @default(uuid())
  vehicleId  String
  driverId   String
  startedAt  DateTime
  endedAt    DateTime?
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model OdometerLog {
  id          String   @id @default(uuid())
  tenantId    String
  vehicleId   String
  driverId    String?
  recordedKm  Int
  recordedAt  DateTime
  notes       String?
  operationId String   @unique
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId, recordedAt])
}

model FuelLog {
  id             String   @id @default(uuid())
  tenantId       String
  vehicleId      String
  driverId       String?
  fueledAt       DateTime
  odometerKm     Int
  fuelType       FuelType
  liters         Decimal  @db.Decimal(10, 2)
  totalCost      Decimal  @db.Decimal(10, 2)
  pricePerLiter  Decimal  @db.Decimal(10, 2)
  stationName    String?
  notes          String?
  previousKm     Int?
  distanceKm     Int      @default(0)
  averageConsumption Decimal @db.Decimal(10, 2)
  operationId    String   @unique
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId, fueledAt])
}

model MaintenanceLog {
  id                  String              @id @default(uuid())
  tenantId            String
  vehicleId           String
  title               String
  maintenanceType     String
  performedAt         DateTime
  odometerKm          Int
  totalCost           Decimal             @db.Decimal(10, 2)
  supplierName        String?
  notes               String?
  nextMaintenanceAt   DateTime?
  nextMaintenanceKm   Int?
  operationId         String              @unique
  vehicle             Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  parts               MaintenancePart[]

  @@index([tenantId, vehicleId, performedAt])
}

model MaintenancePart {
  id               String          @id @default(uuid())
  maintenanceLogId String
  maintenanceLog   MaintenanceLog  @relation(fields: [maintenanceLogId], references: [id], onDelete: Cascade)
  name             String
  brand            String?
  cost             Decimal         @db.Decimal(10, 2)
  nextReplacementKm Int?
  nextReplacementAt DateTime?
}

model PartReplacement {
  id                String    @id @default(uuid())
  tenantId          String
  vehicleId         String
  partName          String
  brand             String?
  cost              Decimal   @db.Decimal(10, 2)
  replacedAt        DateTime
  odometerKm        Int
  nextReplacementKm Int?
  nextReplacementAt DateTime?
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Alert {
  id         String        @id @default(uuid())
  tenantId   String
  title      String
  message    String?
  severity   AlertSeverity
  vehicleId  String?
  driverId   String?
  dueAt      DateTime?
  createdAt  DateTime      @default(now())

  @@index([tenantId, severity, dueAt])
}

model SyncEvent {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId    String
  entity      String
  operation   String
  operationId String          @unique
  payload     Json
  status      SyncEventStatus
  errorMessage String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, status, createdAt])
}
