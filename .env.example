HOST="127.0.0.1"
DATABASE_URL="postgresql://fleet:fleet@localhost:5432/fleet_platform?schema=public"
DATA_ENCRYPTION_KEY="change-me-generate-with-openssl-rand-hex-32"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
PORT=4000
VITE_HOST="127.0.0.1"
VITE_PORT="5173"
VITE_API_URL="http://127.0.0.1:4000/graphql"
BILLING_PROVIDER="mercado_pago"
WEB_BASE_URL="http://127.0.0.1:5173"
# Comma-separated list of front-end origins allowed to call the API.
# Defaults to WEB_BASE_URL (then to local dev origins) when unset.
CORS_ALLOWED_ORIGINS=""
# Days of total inactivity (no user login) before a tenant's personal data
# is automatically anonymized (LGPD retention policy). Default: 730 (~24 months).
RETENTION_INACTIVE_DAYS="730"
# Server-side access token from "Suas integrações" in the Mercado Pago
# developer dashboard. Required to create/read subscriptions (PreApproval).
# Leave empty in environments where billing isn't exercised.
MERCADO_PAGO_ACCESS_TOKEN=""
# Webhook signature secret from the same integration (NOT the access
# token). Required to accept /billing/webhooks/mercado-pago notifications.
MERCADO_PAGO_WEBHOOK_SECRET=""
MEDIA_STORAGE_DIR="uploads"
# Resend (https://resend.com) is tried first when RESEND_API_KEY is set.
# Falls back to SMTP below, then to logging the message to the console.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Fleet Platform <no-reply@fleet.local>"