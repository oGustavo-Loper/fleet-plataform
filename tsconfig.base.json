{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@fleet/shared-types": [
        "packages/shared-types/src"
      ],
      "@fleet/shared-validation": [
        "packages/shared-validation/src"
      ],
      "@fleet/ui": [
        "packages/ui/src"
      ]
    }
  }
}
